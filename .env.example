# ── Database ────────────────────────────────────────────────────────────────
# For local dev with docker-compose.yml, this is auto-set — you don't need it.
# For production docker-compose.prod.yml, set these separately:
DATABASE_URL="postgresql://user:password@localhost:5432/mountain_retreat"

# Only used by docker-compose.prod.yml (app derives DATABASE_URL from these)
POSTGRES_USER="mrr"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="mountain_retreat"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Mapbox ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImNleGFtcGxlIn0.example"

# ── Cloudflare R2 (photo uploads) ────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="mountain-retreat-photos"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
INQUIRY_NOTIFICATION_EMAIL="leads@mountainretreatrealty.com"

# ── Playwright (optional override) ───────────────────────────────────────────
# PLAYWRIGHT_BASE_URL="http://localhost:3000"

# ── Production nginx ─────────────────────────────────────────────────────────
# NGINX_HOST="mountainretreatrealty.com"
# APP_IMAGE="dock.your-registry.io/web/mountain-retreat:latest"
